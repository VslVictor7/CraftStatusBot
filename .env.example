# Todas as variáveis abaixo são obrigatórias, exceto DOMAIN.
# O bot lê o ambiente do processo; no Docker Compose, use env_file.
DISCORD_TOKEN=
HOST='localhost:25565'
DOMAIN= # Opcional: endereço exibido no status; se vazio, usa HOST
# Dai no "HOST" coloca o ip:porta/Dominio real do servidor minecraft

CHANNEL_ID=
MESSAGE_ID=

EVENTS_CHANNEL_ID=

RCON_ADDR='localhost:4444'
RCON_PASSWORD='rcon-password'

SERVER_LOG_PATH='/latest.log'
STATS_FOLDER='/stats'

API_URL=http://helper-api:8000
